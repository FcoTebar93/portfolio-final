---
/** Pantalla de carga al iniciar la web (spinner + overlay que se desliza hacia arriba). */
---

<div id="page-curtain" class="page-curtain" aria-hidden="true">
  <span class="page-curtain__panel page-curtain__panel--left"></span>
  <span class="page-curtain__panel page-curtain__panel--right"></span>
</div>

<div id="preloader-overlay" class="preloader-overlay" aria-hidden="false" aria-busy="true">
  <div id="preloader" class="preloader" role="status" aria-label="Loading">
    <span></span>
    <span></span>
  </div>
</div>

<script>
  const MIN_DISPLAY_MS = 800;
  const SPINNER_EXIT_MS = 400;
  const OVERLAY_EXIT_MS = 1000;
  const CURTAIN_EXIT_MS = 750;
  let curtainOpened = false;

  function syncScrollBeforeReveal() {
    const hash = window.location.hash;
    if (!hash) return;

    const target = document.querySelector(hash);
    if (target instanceof HTMLElement) {
      target.scrollIntoView({ block: "start" });
    }
  }

  function revealAppBeforeCurtain() {
    syncScrollBeforeReveal();
    document.body.classList.remove("preloader-active");
  }

  function openPageCurtain() {
    if (curtainOpened) return;
    curtainOpened = true;

    const curtain = document.getElementById("page-curtain");
    if (!curtain) {
      revealAppBeforeCurtain();
      return;
    }

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    revealAppBeforeCurtain();

    if (reducedMotion) {
      curtain.remove();
      return;
    }

    let cleanedUp = false;
    const cleanup = () => {
      if (cleanedUp) return;
      cleanedUp = true;
      curtain.remove();
    };

    const startCurtainAnimation = () => {
      curtain.classList.add("page-curtain--open");

      const onCurtainEnd = (event: TransitionEvent) => {
        if (event.target !== curtain.querySelector(".page-curtain__panel--right")) return;
        if (event.propertyName !== "width") return;
        curtain.removeEventListener("transitionend", onCurtainEnd);
        cleanup();
      };

      curtain.addEventListener("transitionend", onCurtainEnd);
      window.setTimeout(cleanup, CURTAIN_EXIT_MS + 100);
    };

    requestAnimationFrame(() => {
      requestAnimationFrame(startCurtainAnimation);
    });
  }

  function finishPreloader() {
    const overlay = document.getElementById("preloader-overlay");
    const spinner = document.getElementById("preloader");

    if (!overlay || overlay.dataset.done === "true") return;
    overlay.dataset.done = "true";

    document.body.removeAttribute("aria-busy");

    if (spinner) {
      spinner.classList.add("preloader--exit");
    }

    window.setTimeout(() => {
      overlay.classList.add("preloader-overlay--exit");

      const onOverlayEnd = (event: TransitionEvent) => {
        if (event.propertyName !== "transform") return;
        overlay.removeEventListener("transitionend", onOverlayEnd);
        overlay.remove();
        openPageCurtain();
      };

      overlay.addEventListener("transitionend", onOverlayEnd);

      window.setTimeout(() => {
        if (document.getElementById("preloader-overlay")) {
          overlay.remove();
          openPageCurtain();
        }
      }, OVERLAY_EXIT_MS + 100);
    }, SPINNER_EXIT_MS);
  }

  function startPreloader() {
    const start = Date.now();

    const run = () => {
      const elapsed = Date.now() - start;
      const wait = Math.max(0, MIN_DISPLAY_MS - elapsed);
      window.setTimeout(finishPreloader, wait);
    };

    if (document.readyState === "complete") {
      run();
    } else {
      window.addEventListener("load", run, { once: true });
    }

    window.setTimeout(finishPreloader, 6000);
  }

  startPreloader();
</script>

<style>
  .page-curtain {
    position: fixed;
    inset: 0;
    z-index: 10000;
    pointer-events: none;
  }

  .page-curtain__panel {
    position: absolute;
    top: 0;
    height: 100dvh;
    width: 50%;
    background: var(--color-primary);
  }

  .page-curtain__panel--left {
    left: 0;
  }

  .page-curtain__panel--right {
    right: 0;
  }

  .page-curtain--open .page-curtain__panel {
    width: 0;
    transition: width 0.6s 0.15s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    transform: translateY(0);
    transition: transform 1s cubic-bezier(0.7, 0, 0.3, 1);
  }

  .preloader-overlay--exit {
    transform: translateY(-100%);
  }

  .preloader {
    position: relative;
    width: 80px;
    height: 80px;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .preloader--exit {
    opacity: 0.1;
    transform: translateY(-80px);
  }

  .preloader span {
    position: absolute;
    border: 8px solid var(--color-accent);
    border-top-color: transparent;
    border-radius: 999px;
  }

  .preloader span:nth-child(1) {
    width: 80px;
    height: 80px;
    animation: preloader-spin-1 2s infinite linear;
  }

  .preloader span:nth-child(2) {
    top: 20px;
    left: 20px;
    width: 40px;
    height: 40px;
    animation: preloader-spin-2 1s infinite linear;
  }

  @keyframes preloader-spin-1 {
    0% {
      transform: rotate(360deg);
      opacity: 1;
    }
    50% {
      transform: rotate(180deg);
      opacity: 0.5;
    }
    100% {
      transform: rotate(0deg);
      opacity: 1;
    }
  }

  @keyframes preloader-spin-2 {
    0% {
      transform: rotate(0deg);
      opacity: 0.5;
    }
    50% {
      transform: rotate(180deg);
      opacity: 1;
    }
    100% {
      transform: rotate(360deg);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-curtain--open .page-curtain__panel {
      transition-duration: 0.01ms;
    }

    .preloader-overlay {
      transition-duration: 0.01ms;
    }
    .preloader span {
      animation: none;
    }
    .preloader--exit {
      transition-duration: 0.01ms;
    }
  }
</style>
